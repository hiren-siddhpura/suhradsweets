rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function activeProfile() {
      return signedIn()
        && exists(profilePath())
        && get(profilePath()).data.active == true
        && get(profilePath()).data.role in ['admin', 'account_admin', 'user']
        && ((get(profilePath()).data.get('displayName', '') is string
          && get(profilePath()).data.get('displayName', '').size() > 0)
          || (get(profilePath()).data.get('fullName', '') is string
          && get(profilePath()).data.get('fullName', '').size() > 0));
    }

    function isStaff() {
      return activeProfile()
        && get(profilePath()).data.role in ['admin', 'account_admin'];
    }

    function canManageMaster() { return isStaff(); }

    function ownsRecord() {
      return activeProfile() && resource.data.ownerUid == request.auth.uid;
    }

    function assignedOrder() {
      return activeProfile() && resource.data.get('assignedUserId', null) == request.auth.uid;
    }

    function validCustomerAssignment(data) {
      let uid = data.get('assignedUserId', null);
      return uid == null || (uid is string && uid.size() > 0 && uid.size() <= 128
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(uid)).data.role in ['admin', 'account_admin', 'user']);
    }

    function validText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function validOptionalText(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function customerContactKey(contact) {
      return hashing.sha256(contact.trim().lower().replace('[\\s()-]', '')).toHexString().lower();
    }
    function customerAuditFields(data) {
      return { 'fullName': data.fullName, 'contact': data.contact, 'address': data.address,
        'area': data.area, 'dateOfBirth': data.get('dateOfBirth', null), 'sabha': data.sabha,
        'assignedUserId': data.get('assignedUserId', null) };
    }
    function customerCalendarDate(value) {
      let parts = value.split('-');
      let date = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      return date.year() == int(parts[0]) && date.month() == int(parts[1]) && date.day() == int(parts[2]);
    }
    function validCustomerFields(data) {
      return validText(data.fullName, 120) && data.fullName == data.fullName.trim()
        && validText(data.contact, 80) && data.contact == data.contact.trim()
        && data.contact.lower().replace('[\\s()-]', '').size() > 0
        && validOptionalText(data.address, 300) && data.address == data.address.trim()
        && validText(data.area, 100) && data.area == data.area.trim()
        && data.sabha is bool
        && (data.dateOfBirth == null || (data.dateOfBirth is string
          && data.dateOfBirth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && customerCalendarDate(data.dateOfBirth)))
        && data.contactKey == customerContactKey(data.contact)
        && data.lastAuditId is string && data.lastAuditId.size() > 0
        && data.lastAuditId.size() <= 128 && !data.lastAuditId.matches('.*[/].*')
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
    }
    function validCustomerAudit(eventId, event) {
      let path = /databases/$(database)/documents/customers/$(event.referenceId);
      let after = getAfter(path).data;
      return event.keys().hasOnly(['type', 'actorUid', 'referenceType', 'referenceId', 'detail', 'at'])
        && event.actorUid == request.auth.uid && event.at == request.time
        && event.referenceType == 'customer'
        && event.type == (exists(path) ? 'customer.updated' : 'customer.created')
        && event.detail.keys().hasOnly(['before', 'after', 'import'])
        && (!event.detail.keys().hasAny(['import']) || (
          get(profilePath()).data.role == 'admin'
          && event.type == 'customer.created'
          && event.detail.import.keys().hasOnly(['jobId', 'rowNumber'])
          && event.detail.import.keys().hasAll(['jobId', 'rowNumber'])
          && event.detail.import.jobId is string
          && event.detail.import.jobId.matches('^[a-f0-9]{64}$')
          && event.detail.import.rowNumber is int
          && event.detail.import.rowNumber >= 2
          && event.detail.import.rowNumber <= 100000))
        && event.detail.before == (exists(path) ? customerAuditFields(get(path).data) : null)
        && event.detail.after == customerAuditFields(after)
        && after.lastAuditId == eventId && after.updatedAt == request.time
        && after.updatedBy == request.auth.uid
        && (!exists(path) || get(path).data.get('lastAuditId', '') != eventId);
    }
    function validCustomerDependencies(customerId, data) {
      let reservation = /databases/$(database)/documents/customerContacts/$(data.contactKey);
      let audit = /databases/$(database)/documents/auditLogs/$(data.lastAuditId);
      return getAfter(reservation).data.customerId == customerId
        && getAfter(audit).data.referenceId == customerId
        && validCustomerAudit(data.lastAuditId, getAfter(audit).data);
    }

    function validMasterTimestampsOnCreate() {
      return request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validMasterUpdate(allowedFields) {
      return request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields)
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']);
    }

    function validRole(role) {
      return role in ['admin', 'account_admin', 'user'];
    }

    function canManageProfile(uid, newRole) {
      return isStaff() && request.auth.uid != uid && validRole(newRole)
        && (get(profilePath()).data.role == 'admin' || newRole == 'user');
    }

    function activeUnit(unitId) {
      let unitPath = /databases/$(database)/documents/units/$(unitId);
      return unitId is string && unitId.size() > 0
        && exists(unitPath) && get(unitPath).data.active == true;
    }

    function validItemFields() {
      let data = request.resource.data;
      return validText(data.itemCode, 32)
        && data.itemCode.matches('^[A-Z0-9][A-Z0-9_-]{1,31}$')
        && validText(data.name, 120)
        && validOptionalText(data.description, 500)
        && (data.defaultSellingPrice is int || data.defaultSellingPrice is float)
        && data.defaultSellingPrice >= 0
        && data.defaultSellingPrice <= 100000000
        && (!data.keys().hasAny(['sellingPrice500Gm'])
          || ((data.sellingPrice500Gm is int || data.sellingPrice500Gm is float)
            && data.sellingPrice500Gm >= 0 && data.sellingPrice500Gm <= 100000000))
        && (!data.keys().hasAny(['sellingPrice250Gm'])
          || ((data.sellingPrice250Gm is int || data.sellingPrice250Gm is float)
            && data.sellingPrice250Gm >= 0 && data.sellingPrice250Gm <= 100000000))
        && data.defaultUnitId is string
        && data.active is bool;
    }

    function validUnitFields() {
      let data = request.resource.data;
      return validText(data.name, 120) && validText(data.symbol, 16) && data.active is bool;
    }

    function validPurchaseTypeFields() {
      let data = request.resource.data;
      return validText(data.name, 120)
        && validOptionalText(data.description, 500) && data.active is bool;
    }

    function validSettingFields() {
      let data = request.resource.data;
      return validText(data.key, 80) && validText(data.value, 1000)
        && validOptionalText(data.description, 500) && data.active is bool;
    }

    match /users/{uid} {
      // A user may read their own profile even if inactive, so the UI can explain denial.
      allow get: if signedIn() && (request.auth.uid == uid || isStaff());
      allow list: if isStaff();
      // Profile changes require a trusted operation and an atomic audit entry.
      allow create, update, delete: if false;
    }

    match /units/{unitId} {
      // Active items may still reference a unit that was later deactivated.
      allow get: if activeProfile();
      allow list: if isStaff() || (activeProfile() && resource.data.active == true);
      allow create: if canManageMaster()
        && request.resource.data.keys().hasOnly(['name', 'symbol', 'active', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'symbol', 'active', 'createdAt', 'updatedAt'])
        && validUnitFields() && validMasterTimestampsOnCreate();
      allow update: if canManageMaster() && validUnitFields()
        && validMasterUpdate(['name', 'symbol', 'active', 'updatedAt']);
      allow delete: if false;
    }

    match /purchaseTypes/{purchaseTypeId} {
      allow get, list: if isStaff();
      allow create: if canManageMaster()
        && request.resource.data.keys().hasOnly(['name', 'description', 'active', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'description', 'active', 'createdAt', 'updatedAt'])
        && validPurchaseTypeFields() && validMasterTimestampsOnCreate();
      allow update: if canManageMaster() && validPurchaseTypeFields()
        && validMasterUpdate(['name', 'description', 'active', 'updatedAt']);
      allow delete: if false;
    }

    match /items/{itemId} {
      allow get, list: if isStaff() || (activeProfile() && resource.data.active == true);
      allow create: if canManageMaster()
        && request.resource.data.keys().hasOnly(['itemCode', 'name', 'description', 'defaultSellingPrice', 'sellingPrice500Gm', 'sellingPrice250Gm', 'defaultUnitId', 'active', 'createdAt', 'createdBy', 'updatedAt'])
        && request.resource.data.keys().hasAll(['itemCode', 'name', 'description', 'defaultSellingPrice', 'defaultUnitId', 'active', 'createdAt', 'createdBy', 'updatedAt'])
        && validItemFields()
        && request.resource.data.createdBy == request.auth.uid
        && validMasterTimestampsOnCreate()
        && activeUnit(request.resource.data.defaultUnitId)
        && getAfter(/databases/$(database)/documents/itemCodes/$(request.resource.data.itemCode)).data.itemId == itemId
        && getAfter(/databases/$(database)/documents/itemCodes/$(request.resource.data.itemCode)).data.createdAt == request.time;
      allow update: if canManageMaster() && validItemFields()
        && validMasterUpdate(['name', 'description', 'defaultSellingPrice', 'sellingPrice500Gm', 'sellingPrice250Gm', 'defaultUnitId', 'active', 'updatedAt'])
        && (request.resource.data.defaultUnitId == resource.data.defaultUnitId
          || (!exists(/databases/$(database)/documents/inventory/$(itemId))
            && activeUnit(request.resource.data.defaultUnitId)));
      allow delete: if false;
    }

    // Legacy manual box requirements are retired; this page reads staff-authorized orders.
    match /boxRequirements/{itemId} {
      allow read, write: if false;
    }

    match /itemCodes/{code} {
      allow get: if isStaff();
      allow list: if false;
      allow create: if canManageMaster()
        && request.resource.data.keys().hasOnly(['itemId', 'createdAt'])
        && request.resource.data.keys().hasAll(['itemId', 'createdAt'])
        && request.resource.data.itemId is string
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.itemCode == code
        && getAfter(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /settings/{settingId} {
      function validBusinessDetails() {
        let data = request.resource.data;
        return data.key == 'businessDetails'
          && data.active == true
          && validOptionalText(data.address, 300)
          && validOptionalText(data.contactNumber, 80)
          && validOptionalText(data.fssaiLicenseNo, 40)
          && data.fssaiLicenseNo.matches('^[A-Za-z0-9 /-]*$');
      }
      function validDashboardTarget() {
        return settingId == 'dashboard_sales_target'
          ? request.resource.data.key == 'dashboardSalesTargetKg'
            && request.resource.data.value.matches('^([0-9]{1,9}|1000000000)([.][0-9]{1,3})?$')
          : request.resource.data.key != 'dashboardSalesTargetKg'
            && request.resource.data.key != 'businessDetails';
      }
      allow get: if isStaff() || (activeProfile() && settingId in ['dashboard_sales_target', 'business_details']);
      allow list: if isStaff();
      allow create: if settingId == 'business_details'
        ? isStaff() && get(profilePath()).data.role == 'admin'
          && request.resource.data.keys().hasOnly(['key', 'address', 'contactNumber', 'fssaiLicenseNo', 'active', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['key', 'address', 'contactNumber', 'fssaiLicenseNo', 'active', 'createdAt', 'updatedAt'])
          && validBusinessDetails() && validMasterTimestampsOnCreate()
        : canManageMaster()
          && request.resource.data.keys().hasOnly(['key', 'value', 'description', 'active', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['key', 'value', 'description', 'active', 'createdAt', 'updatedAt'])
          && validSettingFields() && validDashboardTarget() && validMasterTimestampsOnCreate();
      allow update: if settingId == 'business_details'
        ? isStaff() && get(profilePath()).data.role == 'admin'
          && validBusinessDetails()
          && validMasterUpdate(['address', 'contactNumber', 'fssaiLicenseNo', 'updatedAt'])
        : canManageMaster() && validSettingFields() && validDashboardTarget()
          && validMasterUpdate(['value', 'description', 'active', 'updatedAt']);
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow get, list: if isStaff() || assignedOrder();
      // Creation, confirmation, Admin edits, invoicing locks and stock snapshots require trusted operations.
      allow create, update, delete: if false;
    }

    match /invoices/{invoiceId} {
      allow get, list: if isStaff() || ownsRecord();
      // Even Account Admin must use the authenticated Mark as Paid backend operation.
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow get, list: if isStaff() || ownsRecord();
      allow create, update, delete: if false;
    }

    match /paymentReferences/{referenceId} {
      allow read, write: if false;
    }

    match /paymentReversals/{paymentId} {
      allow get, list: if isStaff() || (activeProfile() && exists(/databases/$(database)/documents/payments/$(paymentId)) && get(/databases/$(database)/documents/payments/$(paymentId)).data.ownerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /customers/{customerId} {
      allow get, list: if isStaff() || (activeProfile() && (resource.data.get('assignedUserId', null) == request.auth.uid || resource.data.get('ownerUserIds', []).hasAny([request.auth.uid])));
      // User queries must constrain assignedUserId or ownerUserIds to their authenticated UID.
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['fullName', 'contact', 'address', 'area', 'dateOfBirth', 'sabha', 'contactKey', 'assignedUserId', 'ownerUserIds', 'orderLinks', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'lastAuditId'])
        && validCustomerFields(request.resource.data)
        && validCustomerAssignment(request.resource.data)
        && (request.resource.data.get('assignedUserId', null) == null || get(profilePath()).data.role == 'admin')
        && request.resource.data.ownerUserIds == [] && request.resource.data.orderLinks == {}
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
        && validCustomerDependencies(customerId, request.resource.data);
      allow update: if isStaff() && validCustomerFields(request.resource.data)
        && validCustomerAssignment(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'contact', 'address', 'area', 'dateOfBirth', 'sabha', 'contactKey', 'assignedUserId', 'updatedBy', 'updatedAt', 'lastAuditId'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedUserId']) || get(profilePath()).data.role == 'admin')
        && validCustomerDependencies(customerId, request.resource.data)
        && (resource.data.get('contactKey', customerContactKey(resource.data.contact)) == request.resource.data.contactKey
          || !existsAfter(/databases/$(database)/documents/customerContacts/$(resource.data.get('contactKey', customerContactKey(resource.data.contact)))));
      allow delete: if false;
    }

    match /customerContacts/{contactKey} {
      allow get: if isStaff();
      allow list, update: if false;
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['customerId', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.contactKey == contactKey
        && getAfter(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.updatedAt == request.time;
      allow delete: if isStaff()
        && get(/databases/$(database)/documents/customers/$(resource.data.customerId)).data.contactKey == contactKey
        && getAfter(/databases/$(database)/documents/customers/$(resource.data.customerId)).data.contactKey != contactKey
        && getAfter(/databases/$(database)/documents/customers/$(resource.data.customerId)).data.updatedAt == request.time;
    }

    match /inventory/{itemId} {
      allow get: if isStaff() || (activeProfile()
        && exists(/databases/$(database)/documents/items/$(itemId))
        && get(/databases/$(database)/documents/items/$(itemId)).data.active == true);
      allow list: if isStaff();
      allow create, update, delete: if false;
    }

    match /inventoryMovements/{movementId} {
      // User queries must include where('ownerUid', '==', their UID).
      allow get, list: if isStaff() || ownsRecord();
      allow create, update, delete: if false;
    }

    match /purchases/{purchaseId} {
      allow get, list: if isStaff();
      allow create, update, delete: if false;
    }

    match /specialProducts/{specialProductId} {
      allow get, list: if isStaff() || (activeProfile() && resource.data.active == true);
      allow create, update, delete: if false;
    }

    match /orderControls/{controlId} {
      allow get: if controlId == 'global' && activeProfile();
      allow list, create, update, delete: if false;
    }

    match /targets/{targetId} {
      // User queries must constrain ownerUid to their own UID.
      allow get, list: if isStaff() || ownsRecord();
      allow create, update, delete: if false;
    }

    match /announcements/{announcementId} {
      // User queries must constrain active=true and audience in all/users.
      allow get, list: if isStaff() || (activeProfile() && resource.data.active == true && resource.data.audience in ['all', 'users']);
      allow create, update, delete: if false;
    }

    match /loginLogs/{eventId} {
      allow get, list: if isStaff();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'type', 'at'])
        && request.resource.data.keys().hasAll(['uid', 'type', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['login', 'logout']
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    match /auditLogs/{eventId} {
      // Users may query only their own order/payment events. New events include
      // backend-owned ownerUid and referenceType snapshots; legacy events without
      // these fields remain staff-only rather than becoming broadly readable.
      allow get, list: if isStaff() || (activeProfile()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.referenceType in ['order', 'payment']);
      // Client audit creation is restricted to a matching atomic customer change.
      allow create: if isStaff() && ((get(profilePath()).data.role == 'admin'
          && request.resource.data.keys().hasOnly(['type', 'actorUid', 'referenceType', 'referenceId', 'detail', 'at'])
          && request.resource.data.keys().hasAll(['type', 'actorUid', 'referenceType', 'referenceId', 'detail', 'at'])
          && request.resource.data.type == 'customer.import_completed'
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.referenceType == 'customerImport'
          && request.resource.data.referenceId is string
          && request.resource.data.referenceId.matches('^[a-f0-9]{64}$')
          && request.resource.data.at == request.time
          && request.resource.data.detail.keys().hasOnly(['processed', 'imported', 'existing', 'duplicate', 'invalid', 'failed'])
          && request.resource.data.detail.keys().hasAll(['processed', 'imported', 'existing', 'duplicate', 'invalid', 'failed'])
          && request.resource.data.detail.processed is int
          && request.resource.data.detail.processed >= 0
          && request.resource.data.detail.processed <= 100000
          && request.resource.data.detail.imported is int && request.resource.data.detail.imported >= 0
          && request.resource.data.detail.existing is int && request.resource.data.detail.existing >= 0
          && request.resource.data.detail.duplicate is int && request.resource.data.detail.duplicate >= 0
          && request.resource.data.detail.invalid is int && request.resource.data.detail.invalid >= 0
          && request.resource.data.detail.failed is int && request.resource.data.detail.failed >= 0
          && request.resource.data.detail.processed == request.resource.data.detail.imported
            + request.resource.data.detail.existing + request.resource.data.detail.duplicate
            + request.resource.data.detail.invalid + request.resource.data.detail.failed)
        || validCustomerAudit(eventId, request.resource.data));
      allow update, delete: if false;
    }

    // Any collection or subcollection not explicitly matched is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
